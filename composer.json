{
  "name": "qe-edu/qe-edu",
  "description": "QE-style education WordPress theme + companion plugin (development tooling).",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload-dev": {
    "psr-4": {
      "QeEdu\\Core\\": "plugin/qe-edu-core/src/",
      "QeEdu\\Tests\\": "tests/php/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test": "phpunit",
    "test:coverage": [
      "XDEBUG_MODE=coverage php -d pcov.enabled=1 vendor/bin/phpunit --coverage-clover coverage/clover.xml",
      "@php bin/coverage-report.php coverage/clover.xml 100"
    ]
  }
}
