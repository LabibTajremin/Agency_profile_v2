<?xml version="1.0"?>
<ruleset name="QE Edu">
	<description>WordPress coding standards for the QE Edu theme and plugin.</description>
	<file>theme/qe-edu</file>
	<file>plugin/qe-edu-core</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>
	<config name="installed_paths" value="vendor/wp-coding-standards/wpcs,vendor/phpcsstandards/phpcsutils,vendor/phpcsstandards/phpcsextra,vendor/phpcompatibility/php-compatibility,vendor/phpcompatibility/phpcompatibility-paragonie,vendor/phpcompatibility/phpcompatibility-wp"/>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.6"/>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress-Extra"/>
	<!-- Theme: `qe-edu`; plugin: `qe-edu-core` (tests/php/TextDomainTest.php keeps each package on its own). -->
	<rule ref="WordPress.WP.I18n">
		<properties><property name="text_domain" type="array"><element value="qe-edu"/><element value="qe-edu-core"/></property></properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties><property name="prefixes" type="array"><element value="qe_edu"/><element value="QeEdu"/></property></properties>
	</rule>
	<!-- PSR-4 class files in the plugin. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>plugin/qe-edu-core/src/*</exclude-pattern>
	</rule>
</ruleset>
